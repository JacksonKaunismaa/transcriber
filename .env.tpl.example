# 1Password reference template, used instead of .env (macOS default).
# Copy to .env.tpl (gitignored: vault/item names stay local) and point it at
# your OpenAI API key item. toggle_transcribe.sh runs the transcriber under
# `op run --env-file=.env.tpl`, so the key exists only in that process.
# Manual run: op run --env-file=.env.tpl -- ./transcriber-rs/target/release/transcriber
OPENAI_API_KEY="op://<vault>/<item>/credential"
